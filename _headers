# Cloudflare Pages response headers. GitHub Pages ignores this file.
# Cache-Control max-age is the modern replacement for Expires headers.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# HTML pages keep Cloudflare's default (max-age=0, must-revalidate), so edits
# show up immediately. Everything below gets a long browser cache.

# Images and video: cache for 1 year. When replacing a photo, give the
# new file a new name so returning visitors don't see the old one.
/images/*
  Cache-Control: public, max-age=31536000

# Chatbot files are linked with ?v=N. Bump N in every page when they change.
/fonts/*
  Cache-Control: public, max-age=31536000

/chatbot/*
  Cache-Control: public, max-age=31536000

/favicon.svg
  Cache-Control: public, max-age=2592000

/robots.txt
  Cache-Control: public, max-age=86400
/sitemap.xml
  Cache-Control: public, max-age=86400
/llms.txt
  Cache-Control: public, max-age=86400

# Worker source lives in the repo but is not part of the website
/chatbot-worker/*
  X-Robots-Tag: noindex

/legal.css
  Cache-Control: public, max-age=31536000
